# Discord Webhook (IMPORTANT: Add your webhook URL here, not in code)
# Get from: Discord Server → Settings → Integrations → Webhooks → Create New
# Format: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Port (Railway sets this automatically, don't change)
PORT=5000

# Node environment (production for Railway)
NODE_ENV=production
